{
    "name": "globalpayments/omnipay-globalpayments",
    "type": "library",
    "description": "description",
    "keywords": [
        "gateway",
        "omnipay",
        "heartland",
        "globalpayments",
        "tsys"
    ],
    "authors": [
        {
            "name": "Global Payments",
            "email": "developers@heartland.us"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omnipay\\GlobalPayments\\": "src/GlobalPayments/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\GlobalPayments\\Tests\\": "Tests/"
        }
    },
    "require-dev": {
        "omnipay/tests": "*",
        "squizlabs/php_codesniffer": "3.*"
    },
    "require": {
        "league/omnipay": "^3",
        "globalpayments/php-sdk": "^14",
        "php": ">= 8.2"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
